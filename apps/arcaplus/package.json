{
  "name": "@al/medusa-store",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "db:migrate": "medusa db:migrate",
    "db:generate": "medusa db:generate",
    "db:sync-links": "medusa db:sync-links"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.2.0",
    "@medusajs/cli": "2.2.0",
    "@medusajs/framework": "2.2.0",
    "@medusajs/medusa": "2.2.0",
    "@mikro-orm/core": "5.9.8",
    "@mikro-orm/knex": "5.9.8",
    "@mikro-orm/migrations": "5.9.8",
    "@mikro-orm/postgresql": "5.9.8",
    "awilix": "8.0.1",
    "moment": "2.30.1",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.20.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.2.0",
    "@mikro-orm/cli": "5.9.8",
    "@swc/core": "1.10.7",
    "@swc/jest": "0.2.37",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/react-router-dom": "5.3.3",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "engines": {
    "node": ">=20"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
